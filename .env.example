IMAGE_PROVIDER=mock
BRAND_STYLE_ADMIN_TOKEN=replace-with-a-long-random-admin-token
BRAND_STYLE_PLUGIN_RATE_LIMIT=10
BRAND_STYLE_PLUGIN_GLOBAL_RATE_LIMIT=60
BRAND_STYLE_PLUGIN_RATE_WINDOW_MS=60000
BRAND_STYLE_CONVERSATION_RETENTION_DAYS=30
BRAND_STYLE_MEMBER_DAILY_LIMIT=20
BRAND_STYLE_MEMBER_SESSION_TTL_DAYS=30
BRAND_STYLE_MAX_PARALLEL_GENERATIONS=3
FINTOPIA_API_URL=https://all-in-one-ai.fintopia.tech/
FINTOPIA_API_KEY=replace-with-your-key
FINTOPIA_IMAGE_MODEL=gpt-image-2
FINTOPIA_API_VERSION=2024-02-01

# Telemetry defaults to a local JSONL file. Set TELEMETRY_STORE=supabase
# together with SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY for remote storage.
TELEMETRY_ENABLED=true
TELEMETRY_STORE=local
TELEMETRY_LOCAL_DIR=data/telemetry
TELEMETRY_RETENTION_DAYS=30
TELEMETRY_MAX_EVENTS=50000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TELEMETRY_TABLE=brand_style_telemetry
